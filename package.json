{
  "name": "ertaaniqla-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Tailwind + HTMX + Alpine build for Erta aniqla (no Node at runtime)",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i static/src/input.css -o static/dist/main.css --minify",
    "build:js": "esbuild static/src/main.js --bundle --minify --format=iife --target=es2018 --outfile=static/dist/main.js",
    "watch": "concurrently \"npm:watch:css\" \"npm:watch:js\"",
    "watch:css": "tailwindcss -i static/src/input.css -o static/dist/main.css --watch",
    "watch:js": "esbuild static/src/main.js --bundle --format=iife --target=es2018 --outfile=static/dist/main.js --watch"
  },
  "dependencies": {
    "alpinejs": "^3.14.9",
    "htmx.org": "^2.0.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17"
  }
}
