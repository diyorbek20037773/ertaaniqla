# Normalise line endings: LF in the repo and in checkouts (shell scripts inside Docker must be LF)
* text=auto eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.po text eol=lf
*.mo binary
*.png binary
*.jpg binary
*.webp binary
*.woff2 binary
*.mp4 binary
*.pdf binary
