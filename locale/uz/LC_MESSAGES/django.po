msgstr "Asosiy navigatsiya"

msgid "Account temporarily locked"
msgstr "Hisob vaqtincha bloklangan"

msgid ""
"Too many failed sign-in attempts. Please try again in one hour or contact "
"the administrator."
msgstr ""
"Tizimga kirishga muvaffaqiyatsiz urinishlar juda koʻp. Bir soatdan soʻng "
"qayta urinib koʻring yoki administratorga murojaat qiling."
