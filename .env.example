# ---------------------------------------------------------------------------
# Erta aniqla — environment variables
# Copy to .env (never commit .env). Every variable the project reads is listed.
# Settings module decides defaults: config.settings.{dev,prod,test}
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# 50+ random chars. Rotation procedure: docs/RUNBOOK.md §"Secret rotation"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
# Comma-separated. Prod: ertaaniqla.uz,www.ertaaniqla.uz,oncoportal.uz,www.oncoportal.uz
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
# Comma-separated origins with scheme (prod: https://ertaaniqla.uz,https://oncoportal.uz)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Public base URL used for absolute links, sitemaps, OG tags, Wagtail admin
SITE_BASE_URL=http://localhost:8000
# Environment label for Sentry/logging: dev | staging | prod
ENVIRONMENT=dev
# --- Local docker dev only ---------------------------------------------------
# Host port for the web container (compose.dev.yml); change if 8000 is busy
WEB_PORT=8000
# 1 = build the image with the dev dependency group (debug toolbar, pytest). Never 1 in prod.
INSTALL_DEV=0

# --- Database (PostgreSQL 16) ------------------------------------------------
# Compose publishes the db container on host port 5433 (5432 is often taken locally)
DATABASE_URL=postgres://ertaaniqla:ertaaniqla@localhost:5433/ertaaniqla
# Used by the compose db service itself
POSTGRES_DB=ertaaniqla
POSTGRES_USER=ertaaniqla
POSTGRES_PASSWORD=ertaaniqla
DB_CONN_MAX_AGE=60

# --- Redis (cache, sessions, Celery broker) ---------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Run Celery tasks synchronously in-process (dev/test only)
CELERY_TASK_ALWAYS_EAGER=false

# --- Email -------------------------------------------------------------------
# dev: Mailpit at smtp://localhost:1025 ; prod: smtp+tls://user:pass@smtp.example.uz:587
EMAIL_URL=smtp://localhost:1025
DEFAULT_FROM_EMAIL=noreply@ertaaniqla.uz
# Where moderation notifications (new question / feedback) go
MODERATION_EMAIL=editor@ertaaniqla.uz

# --- PII encryption ----------------------------------------------------------
# Fernet keys, comma-separated, newest first. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: prepend a new key, run `manage.py rotate_pii_keys`, then drop the old key.
PII_ENCRYPTION_KEYS=

# --- Security ----------------------------------------------------------------
# Wagtail admin path (not /admin/ by design)
CMS_URL_PREFIX=cms
# Enforce 2FA for all CMS users (true in prod; may be false in dev)
CMS_2FA_REQUIRED=true
# Cloudflare Turnstile (anti-spam on public forms). Leave empty to disable (dev only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional comma-separated CIDR allow-list for /cms/ (enforced by nginx, see docker/nginx)
CMS_IP_ALLOWLIST=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Git SHA of the running build; set by CI/Dockerfile
APP_RELEASE=dev
LOG_LEVEL=INFO
# Prometheus /metrics endpoint basic-auth (empty = endpoint disabled)
METRICS_BASIC_AUTH=

# --- Analytics ---------------------------------------------------------------
# Yandex.Metrika counter id; loaded only after cookie consent
# Anonymous HTML page cache (seconds); 0 disables. prod default 300 (spec §4.5)
PAGE_CACHE_SECONDS=0
YANDEX_METRIKA_ID=
YANDEX_WEBMASTER_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# --- Media / storage ---------------------------------------------------------
# local | s3   (s3 = any S3-compatible bucket inside Uzbekistan / MinIO)
MEDIA_STORAGE=local
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# Path to ffmpeg binary used by the video transcoding task
FFMPEG_BINARY=ffmpeg
# Max upload sizes (bytes)
MAX_IMAGE_UPLOAD_BYTES=20971520
MAX_VIDEO_UPLOAD_BYTES=536870912
MAX_DOCUMENT_UPLOAD_BYTES=52428800
# Optional ClamAV daemon (compose profile "clamav"); empty = scanning disabled
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Backups (docker/scripts/backup.sh, restic) ------------------------------
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6

# --- Alerts ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- Gunicorn ----------------------------------------------------------------
GUNICORN_WORKERS=5
GUNICORN_TIMEOUT=60
