// Grafana Alloy: ship every container's stdout/stderr (docker json-file) to Loki (ADR-0005).
// Labels stay low-cardinality: project, service, container, stream, level. Everything else
// (request_id, trace_id, event) is queried with `| json`.
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.app.receiver]
}

loki.process "app" {
  // Django/Celery JSON lines: promote the level to a label, keep the rest in the line
  stage.json {
    expressions = { level = "levelname" }
  }
  stage.labels {
    values = { level = "" }
  }
  // never ship secrets that slipped into a log line
  stage.replace {
    // every capture group is replaced: only the value is captured
    expression = `(?i)(?:password|passwd|secret|token|authorization)"?\s*[:=]\s*"?([^"\s,}]+)`
    replace    = "[redacted]"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
